# 默认不做任何行尾转换：工作区文件保持原样，git 也不去"帮"你改。
# 这个仓库在 Windows 上编辑、在 Linux 上部署，任何隐式转换都可能把 .sh 变成 CRLF，
# 到了服务器上就是 "bash\r: No such file or directory"。
* -text

# 下面这些明确按 LF 存、按 LF 取，跨平台一致。
*.sh       text eol=lf
*.py       text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.md       text eol=lf
*.conf     text eol=lf
*.service  text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# 二进制，别让 git 去猜
*.wasm  binary
*.png   binary
*.jpg   binary
*.ico   binary
*.cmo3  binary
*.can3  binary
